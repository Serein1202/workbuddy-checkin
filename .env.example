# ============================================================
# workbuddy-checkin 配置模板（示例文件，不含任何真实凭据）
#
# 用法：把本文件复制为同目录下的 .env.local，然后按需填写。
#   macOS / Linux / Git Bash :  cp .env.example .env.local
#   Windows PowerShell       :  Copy-Item .env.example .env.local
#
# 规则：
#   - 每行 KEY=VALUE；空行与 # 开头的行是注释；等号右侧不要加引号。
#   - 只识别下面列出的 5 个键，其余键与注释一律忽略；文件内容不会被当作代码执行。
#   - 优先级：环境变量 > .env.local。仅需临时启用推送时，可只用环境变量、不创建本文件。
#   - .env.local 已被 .gitignore 忽略，切勿提交仓库、切勿随 skill 分发给他人。
#   - 不需要 Telegram 推送时，不必创建 .env.local（保持未配置即可，签到照常工作）。
#
# 按需启用：需要哪一项，就删掉对应行行首的 "# "（只删注释号，保留 KEY=VALUE 本身）。
# ============================================================

# [必填·启用推送] Telegram 机器人 Token，由 @BotFather 创建机器人后获得
# 形如「数字ID:字母数字串」，请完整复制
# TG_BOT_TOKEN=<你的 Bot Token>

# [必填·启用推送] 接收消息的 chat id / user id
# 私聊为数字 user id（请先给该机器人发送一条消息或 /start）；群组为负数（如 -1001234567890）
# TG_CHAT_ID=<你的 chat id>

# [可选] 本机无法直连 api.telegram.org 时填写代理地址（非凭据，可留空）
# 直连正常请保持注释状态或留空；通用示例：http://127.0.0.1:7890
# TG_PROXY=

# [可选] 推送开关：不写本行时按凭据是否齐全自动判断；1 = 启用；0 = 已拒绝（之后不再询问）
# WB_CHECKIN_TELEGRAM=1

# [可选] 推送请求超时（秒，默认 10）
# WB_CHECKIN_TG_TIMEOUT=10
